{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:acp:schema:v1:github-pull-request",
  "title": "ACP Protocol v1 GitHub Pull Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "pull_request_id",
    "repository_id",
    "number",
    "state",
    "title",
    "head",
    "base",
    "web_url",
    "created_at",
    "updated_at",
    "draft"
  ],
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "commit"],
      "properties": {
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9._/-]+$"
        },
        "commit": { "$ref": "urn:acp:schema:v1:common#/$defs/gitCommit" }
      }
    }
  },
  "properties": {
    "protocol_version": { "const": "1.0" },
    "pull_request_id": { "$ref": "urn:acp:schema:v1:common#/$defs/identifier" },
    "repository_id": { "$ref": "urn:acp:schema:v1:common#/$defs/identifier" },
    "number": { "type": "integer", "minimum": 1 },
    "state": { "enum": ["open", "closed", "merged"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 512 },
    "head": { "$ref": "#/$defs/ref" },
    "base": { "$ref": "#/$defs/ref" },
    "web_url": { "type": "string", "format": "uri", "maxLength": 2048 },
    "created_at": { "$ref": "urn:acp:schema:v1:common#/$defs/timestamp" },
    "updated_at": { "$ref": "urn:acp:schema:v1:common#/$defs/timestamp" },
    "draft": { "type": "boolean" }
  }
}
