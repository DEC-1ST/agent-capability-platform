{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:acp:schema:v1:common",
  "title": "ACP Protocol v1 Common Definitions",
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "role"],
      "properties": {
        "actor_id": { "$ref": "#/$defs/identifier" },
        "role": {
          "type": "string",
          "enum": [
            "orchestrator",
            "planner",
            "developer",
            "reviewer",
            "operator",
            "broker",
            "supervisor",
            "agent",
            "owner"
          ]
        }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "key_id": { "$ref": "#/$defs/identifier" },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_id", "kind", "mode"],
      "properties": {
        "resource_id": { "$ref": "#/$defs/identifier" },
        "kind": {
          "type": "string",
          "enum": ["workspace", "artifact_store", "process", "network", "tool", "profile"]
        },
        "mode": {
          "type": "string",
          "enum": ["read", "write", "execute", "observe", "administer"]
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "name", "media_type", "size_bytes", "digest", "uri"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "media_type": { "type": "string", "minLength": 1, "maxLength": 128 },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "digest": { "$ref": "#/$defs/digest" },
        "uri": { "type": "string", "format": "uri", "maxLength": 2048 }
      }
    }
  }
}
